datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      String   @default("ENGINEER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          String   @id @default(uuid())
  title       String
  status      String   @default("PENDING_REVIEW")
  
  // Flexible JSON payload storing all 35+ survey parameters (Solar or Wi-Fi)
  surveyData  Json?

  // Indexed metadata fields for quick database queries & filtering
  clientName  String?
  siteName    String?
  surveyor    String?
  panelCount  Int?
  inverter    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
enum Category {
  INVERTER
  SOLAR_ARRAY
  BATTERY_STORAGE
  CABLING_SPOOLS
  TERMINALS_TRUNKING
  CONDUIT_RUN
  NETWORK_HARDWARE
}

model InventoryItem {
  id                  String   @id @default(uuid())
  category            Category
  name                String
  description         String?
  unit                String   @default("Units") // Units, Spool Kit, Accessory Pack, Route Kit
  technicalSpecs      String?  // e.g., "5kW Hybrid", "48V Bank", "UV-Resistant Grade"
  unitCost            Float    @default(0.0)
  stockQuantity       Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}